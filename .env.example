# --- Clerk (create keys in the Clerk dashboard) ---------------------------
# Without both keys, `npm run dev` runs with auth OFF (banner shown);
# a production build refuses to serve.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Optional comma-separated Clerk user IDs (user_...). Set = only these users get in.
# Empty = any signed-in user; each user only ever sees their own trades.
ALLOWED_USER_IDS=

# --- Storage -----------------------------------------------------------------
# json = data/trades.json (local dev only) · postgres = Neon via DATABASE_URL
TRADES_STORE=json
DATABASE_URL=
# Owner of the committed seed trades in data/trades.json (and of `npm run db:seed`).
SEED_USER_ID=

# --- Price -------------------------------------------------------------------
# Optional CoinGecko demo key; the public API works without one.
COINGECKO_API_KEY=
