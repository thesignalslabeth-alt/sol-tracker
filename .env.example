# --- Clerk (create keys in the Clerk dashboard) ---------------------------
# Without both keys, `npm run dev` runs with auth OFF (banner shown);
# a production build refuses to serve.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Comma-separated Clerk user IDs allowed in (user_...). The "Not authorized"
# page shows your ID after your first sign-in.
ALLOWED_USER_IDS=

# --- Storage -----------------------------------------------------------------
# json = data/trades.json (local dev only) · postgres = Neon via DATABASE_URL
TRADES_STORE=json
DATABASE_URL=

# --- Price -------------------------------------------------------------------
# Optional CoinGecko demo key; the public API works without one.
COINGECKO_API_KEY=
