# --- Clerk (create keys in the Clerk dashboard) ---------------------------
# Without both keys the app refuses to serve. Local UI work without signing in:
# leave them blank AND set DEV_AUTH_BYPASS=1 (next dev only; ignored in production).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Extra comma-separated Clerk user IDs (user_...), ADDED to the committed list in
# config/allowlist.ts — that file is the real allowlist. Put your dev-instance ID here so
# you can sign in locally. Both empty = any signed-in user; each only sees their own trades.
ALLOWED_USER_IDS=

# --- Mobile app API ------------------------------------------------------------
# Origins allowed to call /api/* cross-origin: only the Expo app's WEB build needs this
# (native iOS/Android apps send no Origin). Comma-separated, e.g. http://localhost:8081
API_CORS_ORIGINS=

# --- Storage -----------------------------------------------------------------
# json = data/trades.json (local dev only) · postgres = Neon via DATABASE_URL
TRADES_STORE=json
DATABASE_URL=
# Owner of the committed seed trades in data/trades.json (and of `npm run db:seed`).
SEED_USER_ID=

# --- Price -------------------------------------------------------------------
# Optional CoinGecko demo key; the public API works without one.
COINGECKO_API_KEY=
